{
  "name": "@thanhtuanxzx/tz-guard",
  "version": "0.1.0",
  "description": "A tiny, sharp TypeScript toolkit to avoid timezone mistakes",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": ["timezone", "dst", "luxon", "typescript", "utc", "iana"],
  "author": "Thanh Tuan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thanhtuanxzx/tz-guard.git"
  },
  "homepage": "https://github.com/thanhtuanxzx/tz-guard#readme",
  "bugs": {
    "url": "https://github.com/thanhtuanxzx/tz-guard/issues"
  },
  "peerDependencies": {
    "luxon": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "luxon": { "optional": false }
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.0.0",
    "luxon": "^3.0.0",
    "typescript": "^5.6.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=18"
  }
}
